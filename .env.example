# API Keys
OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Pinecone Configuration
PINECONE_INDEX_NAME=your_pinecone_index_name
PINECONE_ENVIRONMENT=your_pinecone_environment

# Embedding Configuration
EMBEDDING_MODEL=openai  # Options: openai, cohere
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
COHERE_EMBEDDING_MODEL=embed-english-v3.0

# Retrieval Configuration
SEMANTIC_TOP_K=10  # Number of chunks to retrieve from vector store
RERANK_TOP_K=5     # Number of chunks to keep after reranking
RERANK_MODEL=rerank-english-v3.0  # Cohere reranking model to use

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.0 